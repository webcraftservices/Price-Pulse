# PricePulse backend — environment variables
# Copy this file to .env and fill in real values. Never commit the real .env.

# Google Gemini — used for AI Find's image identification (services/vision.js)
GEMINI_API_KEY=

# Serper.dev — authorized Google Shopping / web search API, powers the
# real price comparison data source (services/stores/googleShopping.js)
SERPER_API_KEY=
SEARCH_PROVIDER=serper

PORT=5000

# Optional — set to "true" to log per-offer match scores and rejected
# offers for each comparison request (backend/services/compareService.js).
# Leave unset/false in normal use; the summary [COMPARE] lines always print.
DEBUG_COMPARE=false

# Optional (Phase 22) — set to "true" to enable the V2 multi-query search
# planner (backend/comparison/searchPlanner.js). V2 is OPT-IN and disabled
# by default. When enabled, it issues multiple targeted queries (e.g. adding
# "price India" or dropping color) to maximize Google Shopping coverage.
# COMPARISON_ENGINE_V2=true

# Optional (Stage 2.3.1) — set to "true" to enable the secondary merchant
# URL resolver (backend/comparison/urlResolver.js), which
# attempts to find a direct Amazon/Flipkart/Croma/etc. product page when
# Serper only returns a Google Shopping redirect. Uses Serper's regular
# web-search endpoint (a second API call, bounded and cached — see the
# resolver's own comments) and requires SERPER_API_KEY.
#
# Disabled by default: this makes a real network call that has not been
# verified against the live API from this development environment. Enable
# it and run scripts/run-live-tests.js to confirm it behaves as expected
# before relying on it in production. If disabled or unconfigured, the
# app is unaffected — offers simply keep their existing Google Shopping
# fallback URL and honest "View on Google Shopping" labeling.
ENABLE_MERCHANT_URL_RESOLVER=false
# Max number of Google-redirect offers the resolver will spend a secondary
# Serper search on per comparison, when enabled above. Optional — defaults
# to 5 if unset.
MERCHANT_URL_RESOLVER_MAX_OFFERS=5

# ─────────────────────────────────────────────────────────────────────────────
# Phase 35A — Authentication + Persistence Foundation (Supabase Auth + Prisma)
# ─────────────────────────────────────────────────────────────────────────────
#
# SUPABASE_URL
#   Your Supabase project URL. Found in: Supabase Dashboard → Settings → API.
#   Used by the backend JWT middleware to construct the JWKS endpoint URL:
#     {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   Also used as the JWT issuer for token verification.
#   Safe to include here — it is not a secret.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# DATABASE_URL
#   PostgreSQL connection string for Prisma.
#   For Supabase: use the "Transaction" pooler URL (port 6543) for serverless/
#   edge, or the "Session" pooler URL (port 5432) for persistent Node processes.
#   Found in: Supabase Dashboard → Settings → Database → Connection string.
#
#   Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
#
#   IMPORTANT: This is a server secret. Never expose it to the browser.
#   IMPORTANT: Use the pooler URL in production (not the direct connection URL)
#              to avoid connection limits on Supabase Free tier.
#              Upgrading to Supabase Pro/higher changes the limits, not the URL format.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# DO NOT ADD:
#   SUPABASE_SERVICE_ROLE_KEY — not needed by this backend; would be a major
#     security risk if accidentally exposed. Supabase JWKS verification uses
#     the public JWKS endpoint, not a shared secret.
#   SUPABASE_JWT_SECRET — the legacy HS256 approach is NOT used. This backend
#     uses modern asymmetric JWT verification via the JWKS endpoint.

# ─────────────────────────────────────────────────────────────────────────────
# Optional: only needed if you activate the corresponding store adapter.
# Currently unused — backend/services/stores/amazon.js and flipkart.js
# are documented stubs until these are configured and implemented.
# ─────────────────────────────────────────────────────────────────────────────

# Amazon Product Advertising API (PA-API 5.0) — requires an approved
# Amazon Associates account.
# AMAZON_PAAPI_ACCESS_KEY=
# AMAZON_PAAPI_SECRET_KEY=
# AMAZON_PAAPI_PARTNER_TAG=

# Flipkart Affiliate API — requires an approved Flipkart Affiliate account.
# FLIPKART_AFFILIATE_ID=
# FLIPKART_AFFILIATE_TOKEN=
