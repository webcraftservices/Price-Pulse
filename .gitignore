# Environment variables / secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Runtime-created, user-uploaded content (AI Find image uploads) — created
# on demand by backend/routes/imageSearch.js and, as of Phase 18, always
# cleaned up after each request; ignored regardless so an upload can never
# accidentally end up committed if cleanup is ever skipped or bypassed.
backend/uploads/

# Prisma generated client (Phase 35A)
# prisma/schema.prisma and prisma/migrations/ ARE tracked in git.
# The generated client lives in node_modules/@prisma/client (already ignored above).
# If you use a custom output path in schema.prisma, ignore that path here too.